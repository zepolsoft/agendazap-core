# Valores usados SOMENTE para trocar os placeholders dos JSONs de workflows/ antes de importar no n8n.
# Copie para .env.local (ignorado pelo git) e preencha. NUNCA commite o .env.local.
# Uso: python3 scripts/preparar_json.py workflows/<pasta>/<arquivo>.json > /tmp/importar.json

# ID do número do WhatsApp Business (Meta > WhatsApp > API Setup > "Phone number ID"). Só dígitos.
PHONE_NUMBER_ID=

# Telefone do responsável que recebe avisos e alertas, só dígitos com DDI (ex.: 5511999990000).
RESPONSAVEL_PHONE=

# E-mail remetente e destinatário dos alertas por e-mail (credencial SMTP no n8n).
EMAIL_REMETENTE=
EMAIL_RESPONSAVEL=

# ID do workflow "Notificação de Erros" na SUA instância (aparece na URL: /workflow/<ID>).
# Usado em settings.errorWorkflow dos demais workflows; importe a Notificação de Erros primeiro.
ID_DO_WORKFLOW_NOTIFICACAO_DE_ERROS=

# NÃO vão aqui (resolva no n8n depois de importar):
# - SUBSTITUA_PELO_ID_DA_CREDENCIAL: reabra cada node e selecione a credencial (Postgres, Google
#   Calendar, WhatsApp, Anthropic, SMTP). Credenciais reais ficam só na instância.
# - SUBSTITUA_PELO_WEBHOOK_ID_DO_TRIGGER / _DO_NODE: o n8n gera o webhookId ao importar; não edite.
