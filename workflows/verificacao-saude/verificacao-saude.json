    {
      "id": "a6eef581-fe34-4bcd-8aa1-d7f49a1b97a3",
      "name": "Classificar Resultado da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst codigo = Number(r.statusCode || 0);\nconst erro = (r.body && r.body.error) || {};\nconst msg = String(erro.message || r.message || (r.error && r.error.message) || r.error || '').slice(0, 160);\nlet tipo = null;\nif (codigo >= 200 && codigo < 300) tipo = null;\nelse if (/credit balance/i.test(msg)) tipo = 'credito';\nelse if (codigo === 401 || codigo === 403) tipo = 'autenticacao';\nelse if (codigo === 429) tipo = 'limite';\nelse if (codigo === 529 || codigo >= 500) tipo = 'indisponivel';\nelse if (!codigo) tipo = 'sem_resposta';\nelse tipo = 'outro';\nreturn [{ json: { servico: 'ia', ok: tipo === null, tipo: tipo, detalhe: tipo === null ? '' : ('HTTP ' + (codigo || '-') + (msg ? ': ' + msg : '')) } }];"
      }
    },
