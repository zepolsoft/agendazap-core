    {
      "id": "e6ef687c-bd8a-404e-b54d-ed802350dcec",
      "name": "Classificar Resultado do WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json;\nconst codigo = Number(r.statusCode || 0);\nconst erro = (r.body && r.body.error) || {};\nconst msg = String(erro.message || r.message || (r.error && r.error.message) || r.error || '').slice(0, 160);\nlet tipo = null;\nif (codigo >= 200 && codigo < 300) tipo = null;\nelse if (codigo === 401 || Number(erro.code) === 190) tipo = 'token';\nelse if (codigo === 429 || [4, 80007, 130429].includes(Number(erro.code))) tipo = 'limite';\nelse if (codigo >= 500) tipo = 'indisponivel';\nelse if (!codigo) tipo = 'sem_resposta';\nelse tipo = 'outro';\nreturn [{ json: { servico: 'whatsapp', ok: tipo === null, tipo: tipo, detalhe: tipo === null ? '' : ('HTTP ' + (codigo || '-') + (msg ? ': ' + msg : '')) } }];"
      }
