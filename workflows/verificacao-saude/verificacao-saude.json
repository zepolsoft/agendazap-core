    {
      "id": "2844134a-e534-4fd1-a73e-978b54467167",
      "name": "Decidir Ações de Alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const COOLDOWN_MIN = 29; // cooldown de 30 min com 1 min de folga para a variação do agendador\nconst agora = new Date();\nconst abertos = $('Listar Incidentes Abertos').all().map(i => i.json).filter(r => r.servico);\nconst resultados = $('Reunir Resultados').all().map(i => i.json);\nconst link = 'https://n8n-n8n.wg1izd.easypanel.host/workflow/' + $workflow.id + '/executions/' + $execution.id;\nconst rotulo = { ia: 'IA (Anthropic)', whatsapp: 'WhatsApp (token/número)' };\nconst descricao = {\n  credito: 'sem crédito na conta',\n  autenticacao: 'chave recusada',\n  limite: 'limite de uso',\n  indisponivel: 'serviço fora do ar',\n  sem_resposta: 'sem resposta (timeout)',\n  token: 'token inválido ou expirado',\n  outro: 'erro inesperado'\n};\nconst hora = d => d.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\nconst duracao = min => min < 60 ? min + ' min' : Math.floor(min / 60) + 'h' + String(min % 60).padStart(2, '0');\nconst saida = [];\n\nfor (const r of resultados) {\n  const doServico = abertos.filter(a => a.servico === r.servico);\n  if (r.ok) {\n    if (!doServico.length) continue;\n    const total = doServico.reduce((s, a) => s + Number(a.falhas || 0), 0);\n    const primeira = new Date(Math.min(...doServico.map(a => new Date(a.primeira_falha_em).getTime())));\n    const min = Math.max(1, Math.round((agora - primeira) / 60000));\n    const texto = '✅ AgendaZap: ' + rotulo[r.servico] + ' voltou\\nFicou com problema por ' + duracao(min) + ' (desde ' + hora(primeira) + ')\\nFalhas no período: ' + total + '\\nExecução: ' + link;\n    saida.push({ json: { acao: 'fechar', notificar: true, servico: r.servico, tipo: '', falhas: total, texto: texto, assunto: '✅ AgendaZap: ' + rotulo[r.servico] + ' voltou' } });\n    continue;\n  }\n  const linha = doServico.find(a => a.tipo === r.tipo);\n  const falhas = (linha ? Number(linha.falhas || 0) : 0) + 1;\n  const primeira = linha ? new Date(linha.primeira_falha_em) : agora;\n  const ultimoAlerta = linha ? new Date(linha.ultimo_alerta_em) : null;\n  const notificar = !linha || (agora - ultimoAlerta) / 60000 >= COOLDOWN_MIN;\n  const texto = '🚨 AgendaZap: ' + rotulo[r.servico] + ' com problema (' + descricao[r.tipo] + ')\\nDesde: ' + hora(primeira) + '\\nFalhas seguidas: ' + falhas + '\\nDetalhe: ' + r.detalhe + '\\nExecução: ' + link;\n  saida.push({ json: {\n    acao: 'gravar', notificar: notificar, servico: r.servico, tipo: r.tipo, falhas: falhas,\n    primeira_falha_em: primeira.toISOString(),\n    ultimo_alerta_em: (notificar ? agora : ultimoAlerta).toISOString(),\n    texto: texto, assunto: '🚨 AgendaZap: ' + rotulo[r.servico] + ' com problema'\n  } });\n}\nreturn saida;"
      }
    },
